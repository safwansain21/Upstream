# DEVELOPMENT ONLY. Copy to .env; never commit actual secrets.
ENVIRONMENT=development
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Worker/seed process only; never add NEXT_PUBLIC_ prefix to this key.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
STORAGE_BUCKET=evidence-private
INTAKE_ORG_ID=01995d20-0000-7000-8000-000000000001
EXAMPLE_MODE=true
MAP_STYLE_URL=
GEOCODER_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
EXPORT_SIGNING_KEY_ID=
EXPORT_SIGNING_PRIVATE_KEY=
FHIR_CANONICAL_BASE=https://upstream.example/fhir
LOG_LEVEL=INFO
